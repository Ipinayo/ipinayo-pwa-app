// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  userRole                UserRole                 @default(USER)
  accounts                Account[]
  sessions                Session[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  profile                 UserProfile?
  selections              MassSelection[]
  massSelectionDrafts     MassSelectionDraft[]
  notifications           Notification[]
  activities              Activity[]               @relation("ActivityActor")
  activitiesTargeted      Activity[]               @relation("ActivityTargets")
  notificationPreferences NotificationPreference[]
  announcements           Announcement[]           @relation("AnnouncementCreator")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model UserProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  bio              String?
  headline         String?
  instruments      String[]
  vocalFach        String?
  favoriteGenres   String[]
  parishName       String?
  choirName        String?
  parishLocationId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parishLocation   Location? @relation(fields: [parishLocationId], references: [id])
}

// Catholic Mass Selection models
model MassSelection {
  id               String            @id @default(cuid())
  title            String
  date             DateTime          @db.Date
  liturgicalYear   LiturgicalYear?
  liturgicalSeason LiturgicalSeason?
  liturgy          String?
  themes           Theme[]
  pastoralFocus    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isPublic         Boolean           @default(false)
  parishName       String?
  choirName        String?
  parishLocationId String?
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parts            MassPart[]
  parishLocation   Location?         @relation(fields: [parishLocationId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([isPublic])
  @@index([date])
  @@index([parishLocationId])
}

model MassPart {
  id              String        @id @default(cuid())
  partName        String
  songTitle       String
  keySignature    KeySignature?
  notes           String?
  massSelectionId String
  order           Int           @default(0)
  massSelection   MassSelection @relation(fields: [massSelectionId], references: [id], onDelete: Cascade)

  @@index([massSelectionId])
  @@index([order])
}

model Theme {
  id             String          @id @default(cuid())
  name           String          @unique
  massSelections MassSelection[]
}

model Location {
  id             String          @id @default(cuid())
  country        String
  countryCode    String?
  state          String          @default("")
  stateCode      String?
  city           String          @default("")
  latitude       Float?
  longitude      Float?
  timezone       String?
  massSelections MassSelection[]
  userProfiles   UserProfile[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([country, state, city])
}

model MassSelectionDraft {
  id               String            @id @default(cuid())
  title            String
  date             DateTime?         @db.Date
  liturgicalYear   LiturgicalYear?
  liturgicalSeason LiturgicalSeason?
  liturgy          String?
  themes           String[]
  pastoralFocus    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isPublic         Boolean           @default(false)
  parishName       String?
  choirName        String?
  template         String?
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parts            Json              @default("[]")
  parishLocation   Json?

  @@index([createdById])
}

model Activity {
  id            String         @id @default(cuid())
  event         String
  entityType    String
  entityId      String
  actorId       String
  actor         User           @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUsers   User[]         @relation("ActivityTargets")
  metadata      Json
  createdAt     DateTime       @default(now())
  notifications Notification[]
}

model Notification {
  id         String             @id @default(cuid())
  activityId String
  activity   Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     NotificationStatus
  title      String
  message    String
  actionUrl  String?
  createdAt  DateTime           @default(now())
  readAt     DateTime?
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  inApp     Boolean
  email     Boolean
  push      Boolean
  updatedAt DateTime @updatedAt

  @@unique([userId, event])
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  message        String
  type           String   @default("general")
  targetUsers    String   @default("all")
  inApp          Boolean  @default(true)
  email          Boolean  @default(false)
  push           Boolean  @default(true)
  recipientCount Int      @default(0)
  createdById    String
  createdBy      User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

enum KeySignature {
  C_MAJOR
  G_MAJOR
  D_MAJOR
  A_MAJOR
  E_MAJOR
  B_MAJOR
  F_SHARP_MAJOR
  C_SHARP_MAJOR
  F_MAJOR
  B_FLAT_MAJOR
  E_FLAT_MAJOR
  A_FLAT_MAJOR
  D_FLAT_MAJOR
  G_FLAT_MAJOR
  C_FLAT_MAJOR

  A_MINOR
  E_MINOR
  B_MINOR
  F_SHARP_MINOR
  C_SHARP_MINOR
  G_SHARP_MINOR
  D_SHARP_MINOR
  A_SHARP_MINOR
  D_MINOR
  G_MINOR
  C_MINOR
  F_MINOR
  B_FLAT_MINOR
  E_FLAT_MINOR
  A_FLAT_MINOR
}

enum LiturgicalYear {
  A
  B
  C
}

enum LiturgicalSeason {
  ADVENT
  CHRISTMAS
  ORDINARY_TIME
  LENT
  EASTER
  PENTECOST
  TRIDUUM
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}
