// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                        @id @default(cuid())
  name                         String?
  email                        String                        @unique
  emailVerified                DateTime?
  image                        String?
  userRole                     UserRole                      @default(USER)
  accounts                     Account[]
  sessions                     Session[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  profile                      UserProfile?
  selections                   MassSelection[]
  massSelectionDrafts          MassSelectionDraft[]
  notifications                Notification[]
  activities                   Activity[]                    @relation("ActivityActor")
  activityRecipients           ActivityRecipient[]
  notificationPreferences      NotificationPreference[]
  announcements                Announcement[]                @relation("AnnouncementCreator")
  pushSubscriptions            PushSubscription[]
  chatSessions                 ChatSession[]
  ownedCollaboratorGroups      CollaboratorGroup[]           @relation("OwnedCollaboratorGroups")
  collaboratorGroupMemberships CollaboratorGroupMember[]
  sentGroupInvitations         CollaboratorGroupInvitation[] @relation("SentGroupInvitations")
  comments                     Comment[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model UserProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  bio              String?
  headline         String?
  instruments      String[]
  vocalFach        String?
  favoriteGenres   String[]
  parishName       String?
  choirName        String?
  parishLocationId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parishLocation   Location? @relation(fields: [parishLocationId], references: [id])
}

// Catholic Mass Selection models
model MassSelection {
  id               String            @id @default(cuid())
  title            String
  date             DateTime          @db.Date
  liturgicalYear   LiturgicalYear?
  liturgicalSeason LiturgicalSeason?
  liturgy          String?
  themes           Theme[]
  pastoralFocus    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isPublic         Boolean           @default(false)
  isFeatured       Boolean           @default(false)
  parishName       String?
  choirName        String?
  parishLocationId String?
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parts            MassPart[]
  parishLocation   Location?         @relation(fields: [parishLocationId], references: [id], onDelete: SetNull)
  groupId          String
  group            CollaboratorGroup @relation(fields: [groupId], references: [id], onDelete: NoAction)
  comments         Comment[]

  @@index([createdById])
  @@index([isPublic])
  @@index([isFeatured])
  @@index([date])
  @@index([parishLocationId])
  @@index([groupId])
}

model MassPart {
  id              String        @id @default(cuid())
  partName        String
  songTitle       String
  keySignature    KeySignature?
  notes           String?
  massSelectionId String
  order           Int           @default(0)
  massSelection   MassSelection @relation(fields: [massSelectionId], references: [id], onDelete: Cascade)

  @@index([massSelectionId])
  @@index([order])
}

model Theme {
  id             String          @id @default(cuid())
  name           String          @unique
  massSelections MassSelection[]
}

model Location {
  id             String          @id @default(cuid())
  country        String
  countryCode    String?
  state          String          @default("")
  stateCode      String?
  city           String          @default("")
  latitude       Float?
  longitude      Float?
  timezone       String?
  massSelections MassSelection[]
  userProfiles   UserProfile[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([country, state, city])
}

model MassSelectionDraft {
  id               String            @id @default(cuid())
  title            String
  date             DateTime?         @db.Date
  liturgicalYear   LiturgicalYear?
  liturgicalSeason LiturgicalSeason?
  liturgy          String?
  themes           String[]
  pastoralFocus    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isPublic         Boolean           @default(false)
  parishName       String?
  choirName        String?
  template         String?
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parts            Json              @default("[]")
  parishLocation   Json?
  groupId          String
  group            CollaboratorGroup @relation(fields: [groupId], references: [id], onDelete: NoAction)
  comments         Comment[]

  @@index([createdById])
  @@index([groupId])
}

/// A reusable set of collaborators owned by one user. Every selection and draft
/// points to exactly one group. An UNNAMED group (`name` is null) is "ad-hoc" —
/// the per-entity direct-access list, belonging to a single selection/draft. A
/// NAMED group is reusable and can be attached to many of the owner's entities.
/// The owner is implicit (`ownerId`, never a member row), so each user has at
/// most one role source for an entity — no role union is ever needed.
model CollaboratorGroup {
  id          String                        @id @default(cuid())
  name        String?
  ownerId     String
  owner       User                          @relation("OwnedCollaboratorGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CollaboratorGroupMember[]
  invitations CollaboratorGroupInvitation[]
  selections  MassSelection[]
  drafts      MassSelectionDraft[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([ownerId])
}

/// A member of a CollaboratorGroup. The role governs view/comment/edit/manage on
/// every selection/draft the group is attached to, and (for MANAGER) the ability
/// to add/remove members. The group owner is never represented here.
model CollaboratorGroupMember {
  id          String            @id @default(cuid())
  groupId     String
  group       CollaboratorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CollaboratorRole  @default(VIEWER)
  invitedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model CollaboratorGroupInvitation {
  id          String            @id @default(cuid())
  groupId     String
  group       CollaboratorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email       String
  role        CollaboratorRole  @default(VIEWER)
  invitedById String?
  invitedBy   User?             @relation("SentGroupInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([groupId, email])
  @@index([email])
  @@index([groupId])
}

/// An INTERNAL collaborator comment on a selection or draft (exactly one of the
/// two). One level of threading: a reply sets `parentId`; replies to replies
/// re-parent to the top comment in the action. Soft-deleted (`deletedAt`) so a
/// removed parent keeps its thread shape. `resolvedAt` marks a thread done.
model Comment {
  id               String              @id @default(cuid())
  selectionId      String?
  selection        MassSelection?      @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  draftId          String?
  draft            MassSelectionDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  mentionedUserIds String[]
  parentId         String?
  parent           Comment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]           @relation("CommentReplies")
  editedAt         DateTime?
  deletedAt        DateTime?
  deletedById      String?
  resolvedAt       DateTime?
  resolvedById     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([selectionId, createdAt])
  @@index([draftId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Activity {
  id            String              @id @default(cuid())
  event         String
  entityType    String
  entityId      String
  actorId       String
  actor         User                @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  recipients    ActivityRecipient[]
  metadata      Json
  createdAt     DateTime            @default(now())
  notifications Notification[]
}

model ActivityRecipient {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([activityId])
  @@index([userId])
}

model Notification {
  id         String             @id @default(cuid())
  activityId String
  activity   Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     NotificationStatus
  title      String
  message    String
  actionUrl  String?
  createdAt  DateTime           @default(now())
  readAt     DateTime?
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  inApp     Boolean
  email     Boolean
  push      Boolean
  updatedAt DateTime @updatedAt

  @@unique([userId, event])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  message        String
  type           String   @default("general")
  targetUsers    String   @default("all")
  inApp          Boolean  @default(true)
  email          Boolean  @default(false)
  push           Boolean  @default(true)
  recipientCount Int      @default(0)
  createdById    String
  createdBy      User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

enum KeySignature {
  C_MAJOR
  G_MAJOR
  D_MAJOR
  A_MAJOR
  E_MAJOR
  B_MAJOR
  F_SHARP_MAJOR
  C_SHARP_MAJOR
  F_MAJOR
  B_FLAT_MAJOR
  E_FLAT_MAJOR
  A_FLAT_MAJOR
  D_FLAT_MAJOR
  G_FLAT_MAJOR
  C_FLAT_MAJOR

  A_MINOR
  E_MINOR
  B_MINOR
  F_SHARP_MINOR
  C_SHARP_MINOR
  G_SHARP_MINOR
  D_SHARP_MINOR
  A_SHARP_MINOR
  D_MINOR
  G_MINOR
  C_MINOR
  F_MINOR
  B_FLAT_MINOR
  E_FLAT_MINOR
  A_FLAT_MINOR
}

enum LiturgicalYear {
  A
  B
  C
}

enum LiturgicalSeason {
  ADVENT
  CHRISTMAS
  ORDINARY_TIME
  LENT
  EASTER
  PENTECOST
  TRIDUUM
}

enum UserRole {
  USER
  FEATURED_AUTHOR
  ADMIN
  SUPERADMIN
}

enum CollaboratorRole {
  MANAGER
  EDITOR
  COMMENTER
  VIEWER
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   Json
  createdAt DateTime    @default(now())

  @@index([sessionId])
}
